+
+test('GET /orders filters by status', async () => {
+  const { status, body } = await getJson(`${api.url}/orders?status=paid`)
+  assert.equal(status, 200)
+  assert.deepEqual(body.items.map((o) => o.id), [2, 3, 5, 8, 11])
+  assert.equal(body.total, 5)
+})
+
+test('GET /orders filters by status before paging', async () => {
+  const { status, body } = await getJson(`${api.url}/orders?status=paid&page=2&limit=2`)
+  assert.equal(status, 200)
+  assert.deepEqual(body.items.map((o) => o.id), [5, 8])
+})
+
+test('GET /orders rejects an unknown status with 400', async () => {
+  const { status, body } = await getJson(`${api.url}/orders?status=bogus`)
+  assert.equal(status, 400)
+  assert.equal(body.error, 'invalid_query')
+  assert.equal(typeof body.message, 'string')
+})
